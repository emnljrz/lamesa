{
  "name": "@lamesa/csv-parser",
  "version": "0.1.0",
  "description": "LaMesa — CSV to JSON parser for @lamesa/core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run"
  },
  "keywords": ["csv", "parser", "lamesa"],
  "license": "MIT",
  "peerDependencies": {
    "@lamesa/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  }
}